{
  "name": "app-template",
  "version": "1.6.4",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "predev": "node scripts/cleanup-temp.js",
    "dev": "node scripts/cleanup-temp.js && concurrently -k \"pnpm dev:server\" \"pnpm dev:metro\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:metro": "node scripts/cleanup-temp.js && cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 npx expo start --web --port ${EXPO_PORT:-8081}",
    "build": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && node scripts/fix-nativewind-cache.js && npx expo export --platform web --output-dir dist-web",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:release": "vitest run lib/app-version.test.ts tests/oauth-login-flow.test.ts tests/oauth-signin-only.test.ts tests/oauth-native-callback.test.ts tests/oauth-session-verification.test.ts tests/google-pkce-signin.test.ts tests/age-gate.test.ts tests/ai-reporting-surfaces.test.ts tests/monitoring-notice.test.ts tests/release-channel-config.test.ts tests/child-monitoring-authorization.test.ts tests/router-access-control.test.ts tests/admin-security.test.ts tests/admin-2fa-enforcement.test.ts tests/totp-security.test.ts tests/notifications.test.ts tests/trigger-date-timezone.test.ts tests/subscription-auth.test.ts tests/subscriber-info-contract.test.ts tests/premium-gating.test.ts tests/paid-endpoint-auth.test.ts tests/remote-config-safety.test.ts tests/play-store-compliance.test.ts tests/sync-refusal-visible.test.ts tests/logout-clears-cached-data.test.ts tests/spouse-visibility-disclosure.test.ts tests/device-compatibility.test.ts tests/ios-config.test.ts tests/adhan-ios-sound.test.ts tests/ios-notification-budget.test.ts tests/modal-orientation.test.ts tests/app-context-sync.test.ts tests/notification-foreground-refresh.test.ts tests/notification-schedule-overlap.test.ts",
    "assert:ios": "bash scripts/assert-ios-artifact.sh",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "qr": "node scripts/generate_qr.mjs",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path'),d=p.join(__dirname,'node_modules','react-native-css-interop','.cache');fs.mkdirSync(d,{recursive:true});fs.writeFileSync(p.join(d,'web.css'),'')\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-google-signin/google-signin": "16.1.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.2",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.90.12",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "@types/pg": "^8.20.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.7",
    "expo": "~54.0.36",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-av": "^16.0.8",
    "expo-background-fetch": "~14.0.9",
    "expo-build-properties": "^1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-device": "^8.0.10",
    "expo-document-picker": "14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-iap": "5.0.0",
    "expo-image": "~3.0.11",
    "expo-image-picker": "17.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "^17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "^15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "express": "^4.22.1",
    "google-auth-library": "10.9.0",
    "jose": "6.1.0",
    "mysql2": "^3.16.0",
    "nativewind": "^4.2.1",
    "pg": "^8.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-android-widget": "^0.20.3",
    "react-native-css-interop": "0.2.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-pager-view": "^6.9.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-volume-manager": "^2.0.8",
    "react-native-web": "~0.21.2",
    "react-native-webview": "^13.15.0",
    "react-native-worklets": "0.5.1",
    "superjson": "^1.13.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.17",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.12": "1.1.18",
      "brace-expansion@2.0.2": "2.1.4",
      "brace-expansion@5.0.7": "5.0.9",
      "fast-uri@3.1.0": "3.1.5",
      "minimatch@3.1.2": "3.1.5",
      "minimatch@9.0.5": "9.0.9",
      "minimatch@10.2.5": "10.2.6",
      "shell-quote@1.8.3": "1.8.4",
      "tar@7.5.2": "7.5.22"
    }
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12"
  }
}
