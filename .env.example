# Rabbaanie — environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored. Production values live in the VM's ~/rabbaanie-api/.env.

HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Auth / cookies — any long random string locally
JWT_SECRET=change-me-to-a-random-string

# Admin panel login
ADMIN_EMAIL=admin@rabbaanie.com
ADMIN_PASSWORD=change-me

# Database — local Postgres 16 (see LOCAL_SETUP.md; container maps host :5433)
DATABASE_URL=postgresql://postgres:rabbaanie@127.0.0.1:5433/rabbaanie

# AI (OpenRouter). NOTE: the old EASY id "google/gemini-2.5-flash-preview" is INVALID (400);
# use a live id such as google/gemini-3.5-flash (verified) or google/gemini-2.5-flash.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_EASY=google/gemini-3.5-flash
OPENROUTER_MODEL_MEDIUM=anthropic/claude-sonnet-4
OPENROUTER_MODEL_HARD=anthropic/claude-opus-4.8

# Email (Brevo)
BREVO_API_KEY=xkeysib-your-key-here
BREVO_SENDER=noreply@rabbaanie.com

APP_URL=http://localhost:3000

# Google OAuth (optional for local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Expo web client — must point at the local API, else it falls back to api.rabbaanie.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
